{
    "name": "@treygrr/nuxt-better-auth-ui",
    "version": "0.0.0",
    "private": true,
    "description": "Admin pages for Better Auth in Nuxt, built with Nuxt UI: manage users, roles, bans and sessions.",
    "keywords": [
        "nuxt",
        "nuxt-module",
        "better-auth",
        "admin",
        "dashboard",
        "nuxt-ui",
        "user-management"
    ],
    "homepage": "https://github.com/treygrr/nuxt-better-auth-ui#readme",
    "bugs": {
        "url": "https://github.com/treygrr/nuxt-better-auth-ui/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/treygrr/nuxt-better-auth-ui"
    },
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/types.d.mts",
            "import": "./dist/module.mjs"
        },
        "./emails": {
            "types": "./dist/emails.d.mts",
            "import": "./dist/emails.mjs"
        },
        "./sms": {
            "types": "./dist/sms.d.mts",
            "import": "./dist/sms.mjs"
        },
        "./providers": {
            "types": "./dist/providers.d.mts",
            "import": "./dist/providers.mjs"
        }
    },
    "main": "./dist/module.mjs",
    "files": [
        "dist"
    ],
    "packageManager": "pnpm@12.14.0",
    "scripts": {
        "build": "nuxt-module-build prepare && nuxt-module-build build",
        "dev": "nuxt dev playground",
        "dev:build": "nuxt build playground",
        "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
        "docs:dev": "pnpm --filter ./docs dev",
        "docs:generate": "pnpm --filter ./docs generate",
        "fmt": "prettier --check src test playground scripts server typecheck auth.config.ts prettier.config.mjs",
        "fmt:fix": "prettier --write src test playground scripts server typecheck auth.config.ts prettier.config.mjs",
        "test": "pnpm build && vitest run",
        "typecheck": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground && vue-tsc --noEmit && vue-tsc --noEmit -p src/runtime/server/tsconfig.json",
        "release": "node scripts/release.mjs",
        "prepack": "pnpm build"
    },
    "dependencies": {
        "@internationalized/date": "^3.12.4",
        "@nuxt/kit": "^4.6.0",
        "@tanstack/charts": "^1.1.0",
        "@tanstack/table-core": "^8.21.3",
        "@vueuse/core": "^14.4.0",
        "@vueuse/nuxt": "^14.4.0",
        "date-fns": "^4.4.0",
        "scule": "^1.3.0",
        "uqr": "0.1.3",
        "zod": "^4.6.7"
    },
    "peerDependencies": {
        "@better-auth/api-key": "^1.7.0",
        "@better-auth/passkey": "^1.7.0",
        "@better-auth/sso": "^1.7.0",
        "@better-auth/stripe": "^1.7.0",
        "@nuxt/ui": "^4.12.0",
        "@nuxtjs/better-auth": "^0.3.13",
        "better-auth": "^1.7.0",
        "nuxt": "^4.6.0",
        "stripe": ">=18"
    },
    "peerDependenciesMeta": {
        "@better-auth/api-key": {
            "optional": true
        },
        "@better-auth/passkey": {
            "optional": true
        },
        "@better-auth/sso": {
            "optional": true
        },
        "@better-auth/stripe": {
            "optional": true
        },
        "stripe": {
            "optional": true
        }
    },
    "devDependencies": {
        "@better-auth/api-key": "1.7.12",
        "@better-auth/passkey": "1.7.12",
        "@better-auth/sso": "1.7.12",
        "@better-auth/stripe": "1.7.12",
        "@nuxt/module-builder": "1.0.3",
        "@nuxt/schema": "4.6.2",
        "@nuxt/ui": "4.12.0",
        "@nuxtjs/better-auth": "0.3.13",
        "@types/better-sqlite3": "7.6.13",
        "@types/node": "24.13.6",
        "better-auth": "1.7.12",
        "better-sqlite3": "13.0.3",
        "nuxt": "4.6.2",
        "playwright-core": "1.64.1",
        "prettier": "3.9.9",
        "stripe": "22.6.2",
        "tailwindcss": "4.3.3",
        "typescript": "6.0.3",
        "vitest": "5.0.5",
        "vue": "3.5.44",
        "vue-tsc": "3.3.13"
    },
    "publishConfig": {
        "access": "public"
    }
}
