# Copy to .env for `pnpm dev`. Read by the playground only.

# Better Auth (see @nuxtjs/better-auth). Optional in development, where Better
# Auth uses a built-in secret.
NUXT_APP_SECRET=

# The playground's address. Better Auth builds OAuth callback URLs from it (eg
# http://localhost:3001/api/auth/callback/github), and the dev server runs on its
# port (nuxt.config.ts), so the two always match.
NUXT_PUBLIC_SITE_URL=http://localhost:3001

# SQLite file for users and sessions. Defaults to .data/auth.sqlite.
# AUTH_DATABASE_PATH=.data/auth.sqlite

# Seeded on startup (server/plugins/auth-setup.ts and server/seed/mock-users.ts):
# an account with the admin role to sign in with, and mock users with linked
# GitHub/Google/Discord accounts, sessions, bans and extra admins. Mock users
# share the admin's password. Leave the admin email empty to skip seeding.
PLAYGROUND_ADMIN_EMAIL=admin@example.com
PLAYGROUND_ADMIN_PASSWORD=password123
PLAYGROUND_MOCK_USERS=40

# Optional: "Continue with GitHub" on the sign-in pages, and connecting GitHub on /account.
# Create an OAuth app at https://github.com/settings/developers with the callback URL
# NUXT_PUBLIC_SITE_URL + /api/auth/callback/github, eg http://localhost:3001/api/auth/callback/github.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
